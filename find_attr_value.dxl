/*
    find_attr_value.dxl   -- DOORS 9.7

    Bir DOORS klasoru (ve istege bagli alt klasorleri) altindaki TUM formal
    modulleri tarar; belirtilen attribute'un belirtilen degere esit oldugu
    modulleri bulur.

    IKI ARAMA MODU:
      "object" -> modul ICINDEKI nesnelerde arar (or. IsDesign = true olan
                  nesnesi olan moduller). Kac nesne eslesti onu da sayar.
      "module" -> modulun KENDI attribute'una bakar (module-level attribute).
      "both"   -> ikisini birden.

    KULLANIM
      1. DOORS Explorer'da herhangi bir yeri ac.
      2. Tools > Edit DXL...
      3. Yapistir, AYARLAR bolumunu duzenle, Run.

    NOT: Cok sayida modul varsa uzun surebilir. Her modul salt-okunur acilir
         ve islem bitince kapatilir; zaten acik olan moduller kapatilmaz.
*/

// ---------------------------------------------------------------------------
// AYARLAR
// ---------------------------------------------------------------------------
string ROOT_FOLDER = "/Proje/Alt Klasor"   // "" birakirsan bulundugun klasor
string ATTR_NAME   = "IsDesign"
string TARGET      = "true"                // aranan deger

string SEARCH_MODE = "object"    // "object" | "module" | "both"
bool   RECURSE     = true        // alt klasorlere de in
bool   IGNORE_CASE = true        // buyuk/kucuk harf farkini yoksay
bool   ONLY_HITS   = true        // sadece eslesme bulunan modulleri yaz

string OUT_FILE = "C:/temp/attr_arama.csv"
string DELIM    = ";"

const int MAX_FOLDERS = 2000
const int MAX_MODULES = 20000

// ---------------------------------------------------------------------------
string folderQueue[MAX_FOLDERS]
int qHead = 0
int qTail = 0

int scannedModules = 0
int hitModules     = 0
int totalHits      = 0
int errorCount     = 0

Stream out = null

// ---------------------------------------------------------------------------
// YARDIMCILAR
// ---------------------------------------------------------------------------
string norm(string s) {
    if (null s) return ""
    if (IGNORE_CASE) return lower(s)
    return s
}

string csvEscape(string s) {
    if (null s) return "\"\""
    Buffer b = create
    b += "\""
    int i
    for (i = 0; i < length(s); i++) {
        char c = s[i]
        if (c == '"')                                  b += "\"\""
        else if (c == '\n' || c == '\r' || c == '\t')  b += " "
        else                                           b += c
    }
    b += "\""
    string r = stringOf(b)
    delete b
    return r
}

string attrText(Object o, string a) {
    string v = probeAttr_(o, a)
    if (null v) return ""
    return v
}

// ---------------------------------------------------------------------------
// TEK BIR MODULU KONTROL ET
// ---------------------------------------------------------------------------
void checkModule(string modPath) {
    // Zaten acik mi? Aciksa kapatmayacagiz.
    Module m = module(modPath)
    bool wasOpen = (!null m)

    if (!wasOpen) m = read(modPath, false)     // salt-okunur, gorunmeden

    if (null m) {
        errorCount++
        return
    }

    scannedModules++

    string moduleValue = ""
    bool   moduleHit   = false
    int    objectHits  = 0

    AttrDef ad = find(m, ATTR_NAME)

    if (!null ad) {
        // --- module-level attribute ---
        if (SEARCH_MODE == "module" || SEARCH_MODE == "both") {
            string v = m.ATTR_NAME ""
            if (!null v) {
                moduleValue = v
                if (norm(v) == norm(TARGET)) moduleHit = true
            }
        }

        // --- object-level attribute ---
        if (SEARCH_MODE == "object" || SEARCH_MODE == "both") {
            Object o
            for o in entire m do {
                if (isDeleted(o)) continue
                if (norm(attrText(o, ATTR_NAME)) == norm(TARGET)) objectHits++
            }
        }
    }

    bool hit = moduleHit || (objectHits > 0)
    if (hit) {
        hitModules++
        totalHits += objectHits
    }

    if (hit || !ONLY_HITS) {
        string adState = "var"
        if (null ad) adState = "attribute yok"
        string hitState = "hayir"
        if (hit) hitState = "EVET"

        out << csvEscape(modPath)      << DELIM
        out << csvEscape(adState)      << DELIM
        out << csvEscape(moduleValue)  << DELIM
        out << csvEscape(objectHits "") << DELIM
        out << csvEscape(hitState)     << "\n"
    }

    if (!wasOpen) close(m)
}

// ---------------------------------------------------------------------------
// KLASOR TARAMASI (ozyineleme yok -- kuyruk ile)
// ---------------------------------------------------------------------------
void enqueue(string path) {
    if (qTail < MAX_FOLDERS) {
        folderQueue[qTail] = path
        qTail++
    }
}

void scanAll() {
    while (qHead < qTail) {
        string fPath = folderQueue[qHead]
        qHead++

        Folder f = folder(fPath)
        if (null f) { errorCount++; continue }

        Item i
        for i in f do {
            if (null i) continue

            string t = type(i)
            string full = fullName(i)

            if (t == "Folder" || t == "Project") {
                if (RECURSE) enqueue(full)
            } else if (t == "Formal") {
                if (scannedModules < MAX_MODULES) checkModule(full)
            }
        }
    }
}

// ---------------------------------------------------------------------------
void run() {
    string start = ROOT_FOLDER
    if (start == "") {
        Folder cf = current Folder
        if (null cf) { ack "Once bir klasor sec."; return }
        start = fullName(cf)
    }

    Folder check = folder(start)
    if (null check) {
        ack "Klasor bulunamadi:\n" start
        return
    }

    out = write(OUT_FILE)
    if (null out) { ack "Dosya yazilamadi: " OUT_FILE; return }

    out << csvEscape("Module")        << DELIM
        << csvEscape("Attribute")     << DELIM
        << csvEscape("Module Value")  << DELIM
        << csvEscape("Object Hits")   << DELIM
        << csvEscape("Eslesme")       << "\n"

    enqueue(start)
    scanAll()

    close(out)

    string report = "Bitti.\n\n"
    report = report "Taranan modul : " scannedModules "\n"
    report = report "Eslesen modul : " hitModules "\n"
    report = report "Eslesen nesne : " totalHits "\n"
    report = report "Hata/atlanan  : " errorCount "\n\n"
    report = report OUT_FILE

    infoBox report
}

run()
