// =====================================================================
// link_ice_aktar.dxl  -  ADIM 2: CSV'deki linkleri SU AN ACIK OLAN module
//                        Absolute Number eslestirmesiyle aktarir
// ---------------------------------------------------------------------
// Kullanim :
//   1) Linklerin aktarilacagi KOPYA modulu acin (gercek aktarimda
//      Exclusive Edit, DENEME_MODU'nda Read yeterli). Linkin diger
//      ucundaki modulleri kapatin.
//   2) Kopya modulun penceresinde Tools > Edit DXL ile calistirin.
//   3) Once DENEME_MODU = true ile calistirip sonuc dosyasini kontrol
//      edin, her sey dogruysa DENEME_MODU = false yapip tekrar calistirin.
//
// Eslestirme:
//   * CSV'deki orijinal modul tarafindaki nesne (GIDEN: kaynak, GELEN:
//     hedef), acik modulde AYNI Absolute Number'li nesne ile eslesir.
//     Klasor / yol ayari YOKTUR.
//   * Linkin diger ucu CSV'de yazan modulun kendisidir. Modul ici
//     linkler acik modulun kendi icinde olusturulur.
//   * GELEN linkler kaynak modulde saklanir; bu yuzden o moduller
//     duzenleme icin acilir ve sonunda kaydedilir.
//   * Sadece Aktar = E olan satirlar islenir.
//
// Not: Kopya DOORS'ta modul Copy/Paste ya da Archive/Restore ile
// alindiysa Absolute Number'lar aynidir. Copy from Baseline ve
// Paste Special yeni numara verir; bu durumu METIN_KONTROL yakalar.
//
// Yetki: Link olusturmak icin link modulunde Modify (M), yeni linkset
// icin Create (C) yetkisi gerekir. Kopya yeni bir modul oldugundan her
// kaynak-hedef cifti icin yeni linkset acilir -> link modulunde M + C sart.
// Orijinal projedeki link modulunde bu yetki yoksa
// LINKLER_KOPYA_KLASORUNDE = true kullanin.
// =====================================================================

// ============================ AYARLAR ================================
string CSV_DOSYASI   = "C:\\temp\\linkler.csv"         // 1. scriptin urettigi, kontrol ettiginiz dosya
string SONUC_DOSYASI = "C:\\temp\\linkler_sonuc.csv"   // her satirin sonucu buraya yazilir
bool   LINKLER_KOPYA_KLASORUNDE = true
                              // true : CSV'deki link modulunun AYNI ISIMLISI, kopya modulun
                              //        klasorunde kullanilir (orn. .../ProjeA/DOORS Links ->
                              //        <kopyanin klasoru>/DOORS Links). Yoksa once DOORS'ta
                              //        olusturun; DENEME sonucu hangi yolun gerektigini yazar.
                              // false: CSV'deki link modulu aynen kullanilir
string LINK_MODULU   = ""     // dolu: yukaridakinden bagimsiz, TUM linkler bu link modulu
                              //       uzerinden olusturulur
bool   METIN_KONTROL = true   // true: acik moduldeki nesnenin metni CSV'dekiyle ayni mi
                              //       bakar, farkliysa sonuc dosyasina yazar (link yine olusur)
int    METIN_UZUNLUK = 80     // 1. scriptteki METIN_UZUNLUK ile AYNI olmali
bool   DENEME_MODU   = true   // true: hicbir sey degistirmez, sadece rapor uretir
// =====================================================================

Module kopya        = current
string kopyaYol     = ""
string kopyaKlasoru = ""
string orijinalYol  = ""
Skip   duzenlenen   = createString   // edit ile acilan moduller (sonunda kaydedilip kapatilir)
Skip   okunan       = createString   // read ile acilan moduller (sonunda kapatilir)
Skip   haritalar    = createString   // modul yolu -> (AbsNo -> Object) listesi
Stream sonuc
bool   kopyaDegisti = false
string mkDurum      = "-"            // o satirin metin kontrol sonucu
string mkMetin      = ""             // metin farkliysa acik moduldeki metin
int olusturulan = 0
int hazir       = 0
int atlanan     = 0
int hatali      = 0
int metinFarkli = 0

// Alanin basindaki/sonundaki bosluk, \r, \t ve tirnaklari temizler
string temizAlan(string s) {
    int bas = 0
    int son = length(s) - 1
    char c
    while (bas <= son) {
        c = s[bas]
        if (c == ' ' || c == '\r' || c == '\t' || c == '"') {
            bas++
        } else {
            break
        }
    }
    while (son >= bas) {
        c = s[son]
        if (c == ' ' || c == '\r' || c == '\t' || c == '"') {
            son--
        } else {
            break
        }
    }
    if (son < bas) return ""
    return s[bas:son]
}

// ; ile ayrilmis satirdan idx numarali alani dondurur (0'dan baslar)
string alanAl(string s, int idx) {
    int n = length(s)
    int bas = 0
    int k = 0
    int i
    for (i = 0; i <= n; i++) {
        if (i < n) {
            if (s[i] != ';') continue
        }
        if (k == idx) {
            if (i > bas) return temizAlan(s[bas:i-1])
            return ""
        }
        k++
        bas = i + 1
    }
    return ""
}

// Metni tek satira indirir (1. scriptteki ile AYNI kurallar)
string temizle(string s) {
    Buffer b = create
    int n = length(s)
    int i
    char c
    for (i = 0; i < n; i++) {
        if (i >= METIN_UZUNLUK) {
            b += "..."
            break
        }
        c = s[i]
        if (c == '\n' || c == '\r' || c == '\t') {
            b += ' '
        } else if (c == ';') {
            b += ','
        } else if (c != '"') {
            b += c
        }
    }
    string r = stringOf(b)
    delete b
    return r
}

// Nesnenin basligi, baslik yoksa metni
string nesneMetni(Object x) {
    string s = x."Object Heading"
    if (null s) {
        s = x."Object Text"
    }
    return temizle(s)
}

// Metni tek satira indirir ama KISALTMAZ (hata mesajlari icin)
string tekSatir(string s) {
    Buffer b = create
    int n = length(s)
    int i
    char c
    for (i = 0; i < n; i++) {
        c = s[i]
        if (c == '\n' || c == '\r' || c == '\t') {
            b += ' '
        } else if (c == ';') {
            b += ','
        } else if (c != '"') {
            b += c
        }
    }
    string r = stringOf(b)
    delete b
    return r
}

// "/Proje/Klasor/Modul" -> "/Proje/Klasor"
string klasorOf(string yol) {
    int i
    for (i = length(yol) - 1; i > 0; i--) {
        if (yol[i] == '/') return yol[0:i-1]
    }
    return ""
}

// "/Proje/Klasor/Modul" -> "Modul"
string adOf(string yol) {
    int i
    for (i = length(yol) - 1; i >= 0; i--) {
        if (yol[i] == '/') return yol[i+1:]
    }
    return yol
}

Module okumaIcinAc(string yol) {
    Module m = null
    if (yol == kopyaYol) return kopya
    if (find(duzenlenen, yol, m)) return m
    if (find(okunan, yol, m)) return m
    ModName_ mref = module(yol)
    if (null mref) return m
    bool acikti = open(mref)
    m = read(yol, false)
    if (!null m && !acikti) put(okunan, yol, m)
    return m
}

Module duzenleIcinAc(string yol) {
    Module m = null
    if (yol == kopyaYol) return kopya
    if (DENEME_MODU) return okumaIcinAc(yol)
    if (find(duzenlenen, yol, m)) return m
    m = edit(yol, false)
    if (!null m) put(duzenlenen, yol, m)
    return m
}

// Modulde verilen Absolute Number'li nesneyi bulur. Filtre / gorunumden
// etkilenmemek icin modulun TUM nesneleri bir kez taranip saklanir.
Object nesneBul(Module m, int no) {
    string yol = fullName m
    Skip h = null
    if (!find(haritalar, yol, h)) {
        h = create
        Object x
        int xNo
        for x in entire m do {
            xNo = x."Absolute Number"
            put(h, xNo, x)
        }
        put(haritalar, yol, h)
    }
    Object o = null
    if (!find(h, no, o)) o = null
    return o
}

// Ayni iki nesne arasinda HERHANGI bir link modulu uzerinden link var mi?
// (Copy/Paste giden linkleri zaten kopyalar; script iki kez calisirsa da
//  kopya olusmasin.)  Varsa o linkin link modulunu, yoksa "" dondurur.
string mevcutLink(Object s, string tm, int tAbs) {
    Link x
    ModName_ xm
    Module xl
    for x in s -> "*" do {
        xm = target(x)
        if (fullName(xm) == tm) {
            if (targetAbsNo(x) == tAbs) {
                xl = module(x)
                if (null xl) return "?"
                return fullName(xl)
            }
        }
    }
    return ""
}

// Acik moduldeki nesnenin metnini CSV'deki metinle karsilastirir
void metinKontrol(Object o, string csvMetin) {
    if (!METIN_KONTROL) return
    if (null csvMetin) return            // CSV'de metin yok (1. scriptte METINLERI_AL = false)
    string acikMetin = temizAlan(nesneMetni(o))
    if (acikMetin == csvMetin) {
        mkDurum = "AYNI"
    } else {
        mkDurum = "FARKLI"
        mkMetin = acikMetin
    }
}

// Tek bir linki kontrol eder / olusturur, sonucu metin olarak dondurur
string linkIsle(string yon, string yeniK, int kAbs, string lMod, string yeniH, int hAbs, string anaMetin) {
    if (!module(lMod))  return "HATA: link modulu bulunamadi: " lMod
    if (!module(yeniK)) return "HATA: kaynak modul bulunamadi"
    if (!module(yeniH)) return "HATA: hedef modul bulunamadi"

    Module km = duzenleIcinAc(yeniK)
    if (null km) return "HATA: kaynak modul duzenleme icin acilamadi"
    Module hm = okumaIcinAc(yeniH)
    if (null hm) return "HATA: hedef modul acilamadi"

    Object ko = nesneBul(km, kAbs)
    if (null ko) return "HATA: kaynak nesne bulunamadi"
    if (isDeleted ko) return "HATA: kaynak nesne silinmis"
    Object ho = nesneBul(hm, hAbs)
    if (null ho) return "HATA: hedef nesne bulunamadi"
    if (isDeleted ho) return "HATA: hedef nesne silinmis"

    // metin kontrolu acik moduldeki tarafta yapilir (GIDEN: kaynak, GELEN: hedef)
    if (yon == "GIDEN") {
        metinKontrol(ko, anaMetin)
    } else {
        metinKontrol(ho, anaMetin)
    }

    string mevcut = mevcutLink(ko, yeniH, hAbs)
    if (!null mevcut) return "ATLANDI: link zaten var (" mevcut ")"
    if (DENEME_MODU) return "HAZIR"

    noError()
    Link yeniLink = ko -> lMod -> ho
    string err = lastError()
    if (!null err) return "HATA: " tekSatir(err)
    if (yeniK == kopyaYol) kopyaDegisti = true
    return "OLUSTURULDU"
}

void satirIsle(string satir, string islenecekYon) {
    string aktar = alanAl(satir, 0)
    if (aktar != "E" && aktar != "e") return
    string yon = alanAl(satir, 1)
    if (yon != islenecekYon) return

    string kMod   = alanAl(satir, 2)
    string kAbsS  = alanAl(satir, 3)
    string lMod   = alanAl(satir, 4)
    string hMod   = alanAl(satir, 5)
    string hAbsS  = alanAl(satir, 6)
    string kMetin = alanAl(satir, 7)
    string hMetin = alanAl(satir, 8)

    if (!null LINK_MODULU) {
        lMod = LINK_MODULU
    } else if (LINKLER_KOPYA_KLASORUNDE) {
        lMod = kopyaKlasoru "/" adOf(lMod)
    }

    // Orijinal modul tarafi acik modulle degistirilir, diger uc aynen kalir
    string anaMod   = hMod
    string anaMetin = hMetin
    string yeniK    = kMod
    string yeniH    = kopyaYol
    if (yon == "GIDEN") {
        anaMod   = kMod
        anaMetin = kMetin
        yeniK    = kopyaYol
        yeniH    = hMod
        if (hMod == kMod) yeniH = kopyaYol   // modul ici link: acik modulun kendi icinde
    }

    mkDurum = "-"
    mkMetin = ""
    string durum = ""
    if (anaMod != orijinalYol) {
        durum = "HATA: satir baska bir modulun linki (" anaMod ")"
    } else if (!isValidInt(kAbsS) || !isValidInt(hAbsS)) {
        durum = "HATA: AbsNo sayi degil"
    } else {
        durum = linkIsle(yon, yeniK, intOf(kAbsS), lMod, yeniH, intOf(hAbsS), anaMetin)
    }

    string csvMetin = ""
    if (mkDurum == "FARKLI") csvMetin = anaMetin
    sonuc << yon ";" yeniK ";" kAbsS ";" lMod ";" yeniH ";" hAbsS ";" durum ";" mkDurum ";" csvMetin ";" mkMetin "\n"

    string p = durum[0:2]
    if (p == "OLU") {
        olusturulan++
    } else if (p == "HAZ") {
        hazir++
    } else if (p == "ATL") {
        atlanan++
    } else {
        hatali++
    }
    if (mkDurum == "FARKLI") metinFarkli++
}

void dosyayiIsle(string yon) {
    Stream girdi = read CSV_DOSYASI
    string satir = ""
    while (true) {
        girdi >> satir
        if (!null satir) satirIsle(satir, yon)
        if (end of girdi) break
    }
    close girdi
}

// CSV'nin hangi modulden alindigini bulur (GIDEN: kaynak, GELEN: hedef sutunu)
string orijinalBul() {
    Stream girdi = read CSV_DOSYASI
    string satir = ""
    string yon = ""
    string yol = ""
    while (true) {
        girdi >> satir
        yon = alanAl(satir, 1)
        if (yon == "GIDEN") yol = alanAl(satir, 2)
        if (yon == "GELEN") yol = alanAl(satir, 5)
        if (!null yol) break
        if (end of girdi) break
    }
    close girdi
    return yol
}

// ============================== ANA KISIM =============================
if (null kopya) {
    ack "Once linklerin aktarilacagi KOPYA modulu acin ve scripti o modulden calistirin."
    halt
}
kopyaYol = fullName kopya
kopyaKlasoru = klasorOf(kopyaYol)

orijinalYol = orijinalBul()
if (null orijinalYol) {
    ack "CSV'de GIDEN / GELEN satiri bulunamadi (ayrac ; olmali):\n" CSV_DOSYASI
    halt
}
if (orijinalYol == kopyaYol) {
    ack "Script ORIJINAL modulde calistirildi.\nLinkleri aktarmak icin KOPYA modulu acip scripti orada calistirin."
    halt
}
if (!DENEME_MODU && !isEdit(kopya)) {
    ack "Gercek aktarim icin acik modulu Exclusive Edit modunda acin."
    halt
}

string lmMetni = "CSV'deki link modulleri (aynen)"
if (LINKLER_KOPYA_KLASORUNDE) lmMetni = "Kopyanin klasorundeki ayni isimli link modulleri:\n    " kopyaKlasoru "/..."
if (!null LINK_MODULU) lmMetni = "Tum linkler:\n    " LINK_MODULU

string modMetni = "GERCEK - linkler olusturulacak ve moduller kaydedilecek"
if (DENEME_MODU) modMetni = "DENEME - hicbir sey degistirilmeyecek"

if (!confirm("CSV'deki orijinal modul:\n    " orijinalYol "\n\nLinklerin aktarilacagi (acik) modul:\n    " kopyaYol "\n\nLink modulu: " lmMetni "\n\n" modMetni "\n\nDevam edilsin mi?")) halt

sonuc = write SONUC_DOSYASI
sonuc << "Yon;KaynakModul;KaynakAbsNo;LinkModulu;HedefModul;HedefAbsNo;Durum;MetinKontrol;CSVdekiMetin;AcikModuldekiMetin\n"

// Once GELEN satirlar (diger moduller duzenleme icin acilir), sonra GIDEN satirlar
dosyayiIsle("GELEN")
dosyayiIsle("GIDEN")

close sonuc

// Nesne listelerini sil
Skip hs
for hs in haritalar do {
    delete hs
}
delete haritalar

Module mm
if (!DENEME_MODU) {
    for mm in duzenlenen do {
        save(mm)
        close(mm)
    }
    if (kopyaDegisti) save(kopya)
}
for mm in okunan do {
    close(mm)
}
delete duzenlenen
delete okunan

string sonDurum = "GERCEK - degisiklikler kaydedildi"
if (DENEME_MODU) sonDurum = "DENEME - hicbir sey degistirilmedi"

ack "Islem tamamlandi (" sonDurum ")\n\nAcik modul: " kopyaYol "\n\nOlusturulan  : " olusturulan "\nHazir        : " hazir "\nAtlanan      : " atlanan "\nHatali       : " hatali "\nMetni farkli : " metinFarkli "\n\nSonuc dosyasi: " SONUC_DOSYASI
