// ============================================================================
//  llr_export.dxl   (v3 - calisan hlr_export.dxl ile ayni yapida)
//
//  Secilen KOK KLASOR (or. LLR) altindaki tum formal modulleri gezer:
//
//    LLR
//      Lib1
//        Module1   ->  Kind=="Class"       (sinif basligi)
//                        Kind=="Function"  (fonksiyon)
//                          Kind=="Requirement"
//        Module2
//      Lib2 ...
//
//  Uretilen CSV:
//    Sinif Konumu;Fonksiyon;Isterler
//    Lib1/Module1/classx;func1;REQ_1, REQ_2, REQ_3
//
//  * Sinif Konumu = <Lib>/<Modul>/<Kind=Class olan ust nesnenin basligi>
//                   (Lib ve Modul adlari asagidaki SOZLUK ile degistirilir)
//  * Fonksiyon    = Kind=Function nesnesinin basligi
//  * Isterler     = o fonksiyonun ALTINDAKI Kind=Requirement nesnelerinin ID'leri
//                   (ust nesne / parent zinciri izlenir)
//
//  Her calismada ayrica REPORT_FILE yazilir: her modul icin nesne sayisi,
//  Class/Function/Requirement sayilari ve moduldeki TUM Kind degerleri.
//  Bir sey beklendigi gibi cikmazsa once bu rapora bakin.
//
//  Calistirma: Database Explorer'da LLR klasorunu acin (ya da ROOT_PATH'i
//              doldurun) -> Tools > Edit DXL... -> Load -> Run
//  Filtre / gorunum fark etmez: tum (silinmemis) nesneler taranir.
// ============================================================================

pragma runLim, 0


// ================================ AYARLAR ===================================

string ROOT_PATH       = ""          // bos = Database Explorer'da acik klasor
                                     // ya da tam yol: "/Proje/LLR"
string OUTPUT_FILE     = "C:\\Temp\\llr_export.csv"
string REPORT_FILE     = "C:\\Temp\\llr_export_rapor.csv"
                                     // (iki dosyanin klasoru de var olmali)

// Kind degerleri (buyuk/kucuk harf ve bas/son bosluk fark etmez)
// NOT: Nitelik adi "Kind" degilse kindOf() ve hasKindAttr() icindeki "Kind"
//      yazan iki yeri degistirin.
string KIND_CLASS      = "Class"
string KIND_FUNC       = "Function"
string KIND_REQ        = "Requirement"

// Ister ID'sinin okunacagi yer (her modul icin sirayla denenir):
//   1) "ID" adli nesne niteligi   (adi farkliysa reqIdOf() icindeki o."ID" ve
//                                  asagidaki ID_ATTR'i birlikte degistirin)
//   2) Acilan gorunumde basligi ID_COLUMN olan sutun
//   3) Hicbiri yoksa DOORS identifier (rapora not dusulur)
string ID_ATTR         = "ID"
string ID_COLUMN       = "ID"

string DELIM           = ";"         // Turkce Excel icin ";"
string ID_JOIN         = ", "        // ayni hucredeki ID'ler arasina
bool   ONE_ROW_PER_REQ = false       // true : her ister ayri satirda
                                     // false: fonksiyon basina 1 satir, ID'ler birlesik
bool   INCLUDE_NESTED  = true        // true : fonksiyonun altindaki TUM seviyeler
                                     // false: sadece fonksiyonun dogrudan altlari
bool   WRITE_EMPTY     = true        // isteri olmayan fonksiyonlar da yazilsin mi
bool   ONLY_MAPPED     = false       // true: sadece SOZLUK'te tanimli klasor/moduller
bool   ASK_CONFIRM     = true        // baslamadan once kok klasoru sor


// ================================ SOZLUK ====================================
//  DXL'de sozluk karsiligi Skip list'tir.
//      put(<harita>, "<DOORS'taki ad>", "<CSV'de gorunecek ad>")
//  Anahtar: sadece ad ("Module1") ya da kok klasore gore yol ("Lib1/Module1").
//  Once yol, sonra ad aranir. Sozlukte olmayan ad oldugu gibi yazilir.

Skip libMap = createString
Skip modMap = createString

// ---- Klasorler (Lib)
put(libMap, "Lib1", "Lib1_GercekAdi")
put(libMap, "Lib2", "Lib2_GercekAdi")
put(libMap, "Lib3", "Lib3_GercekAdi")

// ---- Moduller
put(modMap, "Module1", "Module1_GercekAdi")
put(modMap, "Module2", "Module2_GercekAdi")
put(modMap, "Module3", "Module3_GercekAdi")
put(modMap, "Module4", "Module4_GercekAdi")
put(modMap, "Module5", "Module5_GercekAdi")
put(modMap, "Module6", "Module6_GercekAdi")

// Ayni isimli modul farkli Lib'lerde varsa:
// put(modMap, "Lib1/Module1", "Lib1_Module1_Adi")

// ============================================================================


// ------------------------------------------------------------ durum degiskenleri

Stream outFile
Stream rep

Skip modFull   = create          // sira no -> modul tam yolu
Skip modDisp   = create          // sira no -> "Lib/Modul" (sozlukten)
int  modCount  = 0

int  totFuncs  = 0
int  totReqs   = 0
int  totOrphan = 0
int  nRows     = 0
int  nModErr   = 0
int  nNoKind   = 0
int  nNoFunc   = 0
int  totNoId   = 0               // ID degeri bos olan ister
int  nIdFallbk = 0               // ID bulunamayip identifier kullanilan modul

int    gIdMode = 2               // 0 = nitelik, 1 = gorunum sutunu, 2 = identifier
Column gIdCol  = null


// ---------------------------------------------------------------- yardimcilar

bool isWs(char ch) {
    return (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r')
}

string cleanText(string s) {
    Buffer b = create
    int i
    int n = length(s)
    bool lastWs = true
    char ch
    string r
    for (i = 0; i < n; i++) {
        ch = s[i]
        if (isWs(ch)) {
            if (!lastWs) {
                b += ' '
            }
            lastWs = true
        } else {
            b += ch
            lastWs = false
        }
    }
    r = stringOf(b)
    delete b
    if (length(r) > 0 && r[length(r) - 1] == ' ') {
        r = r[0:length(r) - 2]
    }
    return r
}

string lowerAscii(string s) {
    Buffer b = create
    int i
    int n = length(s)
    int code
    string r
    for (i = 0; i < n; i++) {
        code = intOf(s[i])
        if (code >= 65 && code <= 90) {
            code = code + 32
        }
        b += charOf(code)
    }
    r = stringOf(b)
    delete b
    return r
}

bool sameName(string a, string b) {
    return lowerAscii(cleanText(a)) == lowerAscii(cleanText(b))
}

string firstLine(string s) {
    int i
    int n = length(s)
    for (i = 0; i < n; i++) {
        if (s[i] == '\n' || s[i] == '\r') {
            if (i == 0) {
                return ""
            }
            return s[0:i - 1]
        }
    }
    return s
}

string nodeName(Object o) {
    string h = o."Object Heading" ""
    string t
    h = cleanText(h)
    if (h != "") {
        return h
    }
    t = o."Object Text" ""
    return cleanText(firstLine(t))
}

int absNo(Object o) {
    int a = o."Absolute Number"
    return a
}

string kindOf(Object o) {
    string k = o."Kind" ""
    return cleanText(k)
}

bool hasAttr(Module mod, string attrName) {
    AttrDef ad
    bool found = false
    for ad in mod do {
        if (ad.name == attrName) {
            found = true
            break
        }
    }
    return found
}

bool hasKindAttr(Module mod) {
    return hasAttr(mod, "Kind")
}

// Modulde ID'nin nereden okunacagini belirle (gIdMode / gIdCol)
string setupIdSource(Module mod) {
    Column col
    gIdCol  = null
    gIdMode = 2
    if (hasAttr(mod, ID_ATTR)) {
        gIdMode = 0
        return "nitelik '" ID_ATTR "'"
    }
    for col in mod do {
        if (sameName(title(col), ID_COLUMN)) {
            gIdCol = col
            break
        }
    }
    if (!null gIdCol) {
        gIdMode = 1
        return "sutun '" ID_COLUMN "'"
    }
    return "identifier (ID bulunamadi!)"
}

string reqIdOf(Object o) {
    string v = ""
    if (gIdMode == 0) {
        v = o."ID" ""
    } else if (gIdMode == 1) {
        v = text(gIdCol, o)
    } else {
        v = identifier(o)
    }
    return v
}

// Hucredeki ID'leri ayir (satir sonu , ; | tab) -> '\n' ile birlestir
string idTokens(string s) {
    Buffer outB = create
    Buffer tok = create
    int i
    int n = length(s)
    int nTok = 0
    bool isSep
    char ch
    string t
    string r
    for (i = 0; i <= n; i++) {
        isSep = (i == n)
        if (!isSep) {
            ch = s[i]
            isSep = (ch == '\n' || ch == '\r' || ch == ',' || ch == ';' || ch == '|' || ch == '\t')
        }
        if (isSep) {
            t = cleanText(stringOf(tok))
            if (t != "") {
                if (nTok > 0) {
                    outB += "\n"
                }
                outB += t
                nTok++
            }
            setempty(tok)
        } else {
            tok += ch
        }
    }
    r = stringOf(outB)
    delete outB
    delete tok
    return r
}

string csvField(string s) {
    Buffer b = create
    int i
    int n = length(s)
    bool needQuote = false
    char ch
    char sepCh = DELIM[0]
    string r
    for (i = 0; i < n; i++) {
        ch = s[i]
        if (ch != '"') {
            if (ch == sepCh || ch == '\n' || ch == '\r') {
                needQuote = true
            }
            b += ch
        }
    }
    r = stringOf(b)
    if (needQuote) {
        setempty(b)
        b += '"'
        b += r
        b += '"'
        r = stringOf(b)
    }
    delete b
    return r
}

string addNote(string notes, string more) {
    if (notes == "") {
        return more
    }
    return notes " / " more
}

string mapName(Skip mp, string relKey, string nm) {
    string v = ""
    if (find(mp, relKey, v)) {
        return v
    }
    if (find(mp, nm, v)) {
        return v
    }
    return nm
}

bool isMapped(Skip mp, string relKey, string nm) {
    string v = ""
    if (find(mp, relKey, v)) {
        return true
    }
    if (find(mp, nm, v)) {
        return true
    }
    return false
}


// ------------------------------------------------- sinif / fonksiyon / ister

// Ust nesnelerde ilk Kind=Class olanin basligi (yoksa "")
string classOf(Object o) {
    Object p = parent(o)
    string r = ""
    while (!null p) {
        if (sameName(kindOf(p), KIND_CLASS)) {
            r = nodeName(p)
            break
        }
        p = parent(p)
    }
    return r
}

// Isterin ait oldugu fonksiyonun Absolute Number'i; yoksa -1
int ownerFunc(Object o, Skip cntMap) {
    Object p = parent(o)
    int depth = 1
    int r = -1
    int a
    int dummy
    while (!null p) {
        if (sameName(kindOf(p), KIND_FUNC)) {
            if (INCLUDE_NESTED || depth == 1) {
                a = absNo(p)
                if (find(cntMap, a, dummy)) {
                    r = a
                }
            }
            break
        }
        p = parent(p)
        depth++
    }
    return r
}

// ID'ler fonksiyon basina '\n' ile ayrilmis tek string olarak tutulur
void addId(Skip idMap, Skip cntMap, int owner, string id) {
    string cur = ""
    int cnt = 0
    if (find(idMap, owner, cur)) {
        delete(idMap, owner)
    }
    if (cur == "") {
        cur = id
    } else {
        cur = cur "\n" id
    }
    put(idMap, owner, cur)
    if (find(cntMap, owner, cnt)) {
        delete(cntMap, owner)
    }
    put(cntMap, owner, cnt + 1)
}

void writeFuncRows(string loc, string fnm, string idsNl) {
    Buffer tok = create
    Buffer joined = create
    int i
    int n = length(idsNl)
    int nTok = 0
    char ch
    string t
    string rowStr
    for (i = 0; i <= n; i++) {
        if (i == n) {
            ch = '\n'
        } else {
            ch = idsNl[i]
        }
        if (ch == '\n') {
            t = cleanText(stringOf(tok))
            if (t != "") {
                if (ONE_ROW_PER_REQ) {
                    rowStr = csvField(loc) DELIM csvField(fnm) DELIM csvField(t)
                    outFile << rowStr "\n"
                    nRows++
                } else {
                    if (nTok > 0) {
                        joined += ID_JOIN
                    }
                    joined += t
                }
                nTok++
            }
            setempty(tok)
        } else {
            tok += ch
        }
    }
    if (!ONE_ROW_PER_REQ && nTok > 0) {
        rowStr = csvField(loc) DELIM csvField(fnm) DELIM csvField(stringOf(joined))
        outFile << rowStr "\n"
        nRows++
    }
    if (nTok == 0 && WRITE_EMPTY) {
        rowStr = csvField(loc) DELIM csvField(fnm) DELIM ""
        outFile << rowStr "\n"
        nRows++
    }
    delete tok
    delete joined
}


// ------------------------------------------------------------- tek modul

void processModule(string fn, string disp) {
    Module mod
    bool wasOpen
    string err
    Object o
    int a
    int owner
    int seq   = 0
    int nObj  = 0
    int nCls  = 0
    int nFn   = 0
    int nRq   = 0
    int nOrph = 0
    int nNoId = 0
    int kv
    string idSrc
    string reqIds
    string k
    string kn
    string nm
    string cls
    string ids
    string loc
    string note = ""
    string rowStr
    string kindDist
    Skip fSeq
    Skip fName
    Skip fCls
    Skip fIds
    Skip fCnt
    Skip kc
    Buffer kb

    wasOpen = open(module fn)

    noError()
    mod = read(fn, false)
    err = lastError()
    if (!null err || null mod) {
        nModErr++
        rowStr = csvField(disp) DELIM csvField(fn) DELIM "0" DELIM "0" DELIM "0" DELIM "0" DELIM "0" DELIM "0" DELIM "" DELIM "" DELIM csvField("modul acilamadi: " err)
        rep << rowStr "\n"
        return
    }

    if (!hasKindAttr(mod)) {
        nNoKind++
        rowStr = csvField(disp) DELIM csvField(fn) DELIM "0" DELIM "0" DELIM "0" DELIM "0" DELIM "0" DELIM "0" DELIM "" DELIM "" DELIM "Kind niteligi yok - atlandi"
        rep << rowStr "\n"
        if (!wasOpen) {
            close(mod)
        }
        return
    }

    idSrc = setupIdSource(mod)
    if (gIdMode == 2) {
        nIdFallbk++
    }

    fSeq  = create
    fName = create
    fCls  = create
    fIds  = create
    fCnt  = create
    kc    = createString

    // ---- 1. gecis: siniflar ve fonksiyonlar
    for o in entire mod do {
        if (isDeleted(o)) {
            continue
        }
        nObj++
        k = kindOf(o)

        kn = k
        if (kn == "") {
            kn = "(bos)"
        }
        kv = 0
        if (find(kc, kn, kv)) {
            delete(kc, kn)
        }
        put(kc, kn, kv + 1)

        if (sameName(k, KIND_CLASS)) {
            nCls++
        } else if (sameName(k, KIND_FUNC)) {
            a = absNo(o)
            put(fSeq, seq, a)
            put(fName, a, nodeName(o))
            put(fCls, a, classOf(o))
            put(fIds, a, "")
            put(fCnt, a, 0)
            seq++
            nFn++
        }
    }

    // ---- 2. gecis: isterler
    for o in entire mod do {
        if (isDeleted(o)) {
            continue
        }
        k = kindOf(o)
        if (!sameName(k, KIND_REQ)) {
            continue
        }
        nRq++
        owner = ownerFunc(o, fCnt)
        if (owner < 0) {
            nOrph++
            continue
        }
        reqIds = idTokens(reqIdOf(o))
        if (reqIds == "") {
            nNoId++
            continue
        }
        addId(fIds, fCnt, owner, reqIds)
    }

    // ---- 3. CSV satirlari
    for a in fSeq do {
        nm  = ""
        cls = ""
        ids = ""
        find(fName, a, nm)
        find(fCls, a, cls)
        find(fIds, a, ids)
        loc = disp
        if (cls != "") {
            loc = disp "/" cls
        }
        writeFuncRows(loc, nm, ids)
    }

    // ---- 4. rapor satiri
    kb = create
    for kv in kc do {
        kn = (string key kc)
        kb += kn "=" kv "  "
    }
    kindDist = stringOf(kb)
    delete kb

    if (nFn == 0) {
        nNoFunc++
        note = addNote(note, "hic Function yok - Kind degerlerini kontrol edin")
    }
    if (nCls == 0) {
        note = addNote(note, "hic Class yok")
    }
    if (nOrph > 0) {
        note = addNote(note, nOrph " ister bir Function altinda degil")
    }
    if (nNoId > 0) {
        note = addNote(note, nNoId " isterin ID degeri bos - yazilmadi")
    }
    if (gIdMode == 2) {
        note = addNote(note, "'" ID_ATTR "' niteligi / sutunu yok - identifier yazildi")
    }

    rowStr = csvField(disp) DELIM csvField(fn) DELIM nObj "" DELIM nCls "" DELIM nFn "" DELIM nRq "" DELIM nOrph "" DELIM nNoId "" DELIM csvField(idSrc) DELIM csvField(kindDist) DELIM csvField(note)
    rep << rowStr "\n"

    totFuncs  = totFuncs + nFn
    totReqs   = totReqs + nRq - nOrph - nNoId
    totOrphan = totOrphan + nOrph
    totNoId   = totNoId + nNoId
    gIdCol    = null

    delete fSeq
    delete fName
    delete fCls
    delete fIds
    delete fCnt
    delete kc

    if (!wasOpen) {
        close(mod)
    }
}


// ================================== ANA AKIS =================================

string errMsg = ""
string rootPath = ROOT_PATH
string fileErr = ""

if (rootPath == "") {
    Folder curF = current
    if (!null curF) {
        rootPath = fullName(curF)
    }
}

if (rootPath == "") {
    errMsg = "Kok klasor belirlenemedi.\n\n"
    errMsg = errMsg "Database Explorer'da LLR klasorunu acip oradan Tools > Edit DXL ile "
    errMsg = errMsg "calistirin ya da ROOT_PATH'i doldurun (or. \"/Proje/LLR\")."
    errorBox(errMsg)
    halt
}

noError()
Item rootIt = item(rootPath)
fileErr = lastError()
if (!null fileErr || null rootIt) {
    errorBox("Kok klasor bulunamadi:\n" rootPath "\n\n" fileErr)
    halt
}
if (type(rootIt) != "Folder" && type(rootIt) != "Project") {
    errorBox("Kok oge bir klasor/proje degil (tip: " type(rootIt) "):\n" rootPath)
    halt
}

if (ASK_CONFIRM) {
    if (!confirm("Kok klasor:\n" rootPath "\n\nBu klasorun altindaki tum formal moduller islenecek. Devam?")) {
        halt
    }
}


// -------------------------------- modulleri topla (ozyinelemesiz, kuyrukla)

Skip qPath = create
Skip qRel  = create
Skip qDisp = create
int  qHead = 0
int  qTail = 0

string curPath
string curRel
string curDisp
string t
string nm
string rel
string dn
string dp
Folder f
Item itm

put(qPath, qTail, rootPath)
put(qRel,  qTail, "")
put(qDisp, qTail, "")
qTail++

while (qHead < qTail) {
    curPath = ""
    curRel  = ""
    curDisp = ""
    find(qPath, qHead, curPath)
    find(qRel,  qHead, curRel)
    find(qDisp, qHead, curDisp)
    qHead++

    f = folder(curPath)
    if (null f) {
        continue
    }

    for itm in f do {
        if (isDeleted(itm)) {
            continue
        }
        t  = type(itm)
        nm = name(itm)
        if (curRel == "") {
            rel = nm
        } else {
            rel = curRel "/" nm
        }

        if (t == "Folder" || t == "Project") {
            if (ONLY_MAPPED && !isMapped(libMap, rel, nm)) {
                continue
            }
            dn = mapName(libMap, rel, nm)
            if (curDisp == "") {
                dp = dn
            } else {
                dp = curDisp "/" dn
            }
            put(qPath, qTail, fullName(itm))
            put(qRel,  qTail, rel)
            put(qDisp, qTail, dp)
            qTail++
        } else if (t == "Formal") {
            if (ONLY_MAPPED && !isMapped(modMap, rel, nm)) {
                continue
            }
            dn = mapName(modMap, rel, nm)
            if (curDisp == "") {
                dp = dn
            } else {
                dp = curDisp "/" dn
            }
            put(modFull, modCount, fullName(itm))
            put(modDisp, modCount, dp)
            modCount++
        }
    }
}

delete qPath
delete qRel
delete qDisp

if (modCount == 0) {
    errorBox("Kok klasor altinda islenecek formal modul bulunamadi:\n" rootPath)
    halt
}


// ------------------------------------------------------------- dosyalar

noError()
rep = write(REPORT_FILE)
fileErr = lastError()
if (!null fileErr) {
    errMsg = "Rapor dosyasi acilamadi:\n" REPORT_FILE "\n\n" fileErr "\n\n"
    errMsg = errMsg "Klasorun var oldugundan emin olun; dosya Excel'de aciksa kapatin."
    errorBox(errMsg)
    halt
}

noError()
outFile = write(OUTPUT_FILE)
fileErr = lastError()
if (!null fileErr) {
    close(rep)
    errMsg = "Cikti dosyasi acilamadi:\n" OUTPUT_FILE "\n\n" fileErr "\n\n"
    errMsg = errMsg "Klasorun var oldugundan emin olun; dosya Excel'de aciksa kapatin."
    errorBox(errMsg)
    halt
}

string rowStr
rowStr = "Modul (CSV adi)" DELIM "DOORS yolu" DELIM "Nesne" DELIM "Class" DELIM "Function" DELIM "Requirement" DELIM "Fonksiyonsuz Req" DELIM "ID'si bos Req" DELIM "ID kaynagi" DELIM "Kind dagilimi" DELIM "Not"
rep << rowStr "\n"
rowStr = "Sinif Konumu" DELIM "Fonksiyon" DELIM "Isterler"
outFile << rowStr "\n"


// -------------------------------------------------------- modulleri isle

int i
string mFull
string mDisp
for (i = 0; i < modCount; i++) {
    mFull = ""
    mDisp = ""
    find(modFull, i, mFull)
    find(modDisp, i, mDisp)
    processModule(mFull, mDisp)
}

close(outFile)
close(rep)
delete modFull
delete modDisp


// -------------------------------------------------------------- ozet

string msg = "Tamamlandi.\n\n"
msg = msg "Kok klasor:  " rootPath "\n"
msg = msg "Islenen modul:  " modCount "\n"
msg = msg "Fonksiyon:  " totFuncs "\n"
msg = msg "Fonksiyona baglanan ister:  " totReqs "\n"
msg = msg "Fonksiyon altinda olmayan ister:  " totOrphan "\n"
msg = msg "ID degeri bos ister (yazilmadi):  " totNoId "\n"
msg = msg "ID bulunamayip identifier kullanilan modul:  " nIdFallbk "\n"
msg = msg "CSV satiri (baslik haric):  " nRows "\n\n"
msg = msg "Kind niteligi olmayan modul:  " nNoKind "\n"
msg = msg "Hic Function bulunmayan modul:  " nNoFunc "\n"
msg = msg "Acilamayan modul:  " nModErr "\n\n"
msg = msg "CSV:    " OUTPUT_FILE "\n"
msg = msg "Rapor:  " REPORT_FILE "\n"

if (totFuncs == 0 || nNoKind > 0 || nModErr > 0 || nIdFallbk > 0) {
    msg = msg "\nUYARI: Bazi moduller beklendigi gibi islenmedi. Rapor dosyasindaki\n"
    msg = msg "'Kind dagilimi' ve 'Not' sutunlarina bakin."
    warningBox(msg)
} else {
    infoBox(msg)
}
