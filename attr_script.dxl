/*
    export_two_columns.dxl

    Acik olan DOORS modulunden secilen IKI attribute'u CSV olarak disari aktarir.

    KULLANIM
      1. Modulu ac (formal module).
      2. Tools > Edit DXL... menusunu ac.
      3. Bu dosyayi yapistir, asagidaki AYARLAR bolumunu duzenle, Run'a bas.
*/

// ---------------------------------------------------------------------------
// AYARLAR
// ---------------------------------------------------------------------------
const string ATTR_1     = "Object Heading"     // 1. kolon
const string ATTR_2     = "Object Text"        // 2. kolon
const string OUT_FILE   = "C:/temp/doors_export.csv"
const string DELIM      = ";"                  // Excel TR icin ; , EN icin ,

const bool INCLUDE_ID   = true    // basa Absolute Number kolonu ekle
const bool ONLY_VISIBLE = false   // true -> sadece filtreden gecen nesneler
const bool SKIP_HEADINGS = false  // true -> baslik (heading) nesnelerini atla

// ---------------------------------------------------------------------------
// YARDIMCI: CSV alani kacisi
// ---------------------------------------------------------------------------
string csvEscape(string s) {
    if (null s) return "\"\""

    Buffer b = create
    b += "\""
    int i
    for (i = 0; i < length(s); i++) {
        char c = s[i]
        if (c == '"') {
            b += "\"\""              // tirnak ikile
        } else if (c == '\n' || c == '\r') {
            b += " "                 // satir sonunu bosluga cevir
        } else {
            b += c ""
        }
    }
    b += "\""

    string result = stringOf(b)
    delete b
    return result
}

// ---------------------------------------------------------------------------
// YARDIMCI: attribute degerini guvenli oku
// ---------------------------------------------------------------------------
string safeAttr(Object o, string attrName) {
    if (!exists attribute attrName) return ""

    string v = o.attrName ""
    if (null v) return ""
    return v
}

// ---------------------------------------------------------------------------
// ANA ISLEM
// ---------------------------------------------------------------------------
void run() {
    Module m = current Module
    if (null m) {
        ack "Once bir modul acmalisin."
        return
    }

    // Attribute'ler gercekten var mi?
    if (!exists attribute ATTR_1) {
        ack "Bu modulde '" ATTR_1 "' adinda bir attribute yok."
        return
    }
    if (!exists attribute ATTR_2) {
        ack "Bu modulde '" ATTR_2 "' adinda bir attribute yok."
        return
    }

    Stream out = write(OUT_FILE)
    if (null out) {
        ack "Dosya yazilamadi: " OUT_FILE "\nKlasor var mi, yazma izni var mi?"
        return
    }

    // BOM -> Excel Turkce karakterleri dogru gostersin
    out << "\xEF\xBB\xBF"

    // Baslik satiri
    if (INCLUDE_ID) out << csvEscape("Absolute Number") << DELIM
    out << csvEscape(ATTR_1) << DELIM << csvEscape(ATTR_2) << "\n"

    Object o
    int count = 0

    for o in (ONLY_VISIBLE ? m : entire m) do {
        if (isDeleted(o)) continue
        if (SKIP_HEADINGS && (o."Object Heading" "") != "" &&
                             (o."Object Text" "") == "") continue

        if (INCLUDE_ID) out << csvEscape(number(o) "") << DELIM
        out << csvEscape(safeAttr(o, ATTR_1)) << DELIM
        out << csvEscape(safeAttr(o, ATTR_2)) << "\n"

        count++
    }

    close(out)
    infoBox "Bitti.\n" count " nesne yazildi:\n" OUT_FILE
}

run()
