string FOLDER = "/Proje/Klasor"      // BURAYI KENDI YOLUNLA DEGISTIR
string ATTR   = "IsDesign"           // bakilacak attribute
string TARGET = "D"                  // aranan deger

print "BASLADI\n"

int scanned = 0
int found   = 0

Folder f = folder(FOLDER)
if (null f) {
    print "Klasor NULL -> " FOLDER "\n"
} else {
    print "Klasor bulundu: " fullName(f) "\n"
    print "Aranan: " ATTR " = " TARGET "\n"
    print "-------------------------------------------\n"

    Item i
    for i in f do {
        if (type(i) != "Formal") continue

        string path = fullName(i)
        Module m = read(path, false)

        if (null m) {
            print "ACILAMADI : " path "\n"
            continue
        }

        scanned++

        AttrDef ad = find(m, ATTR)
        if (null ad) {
            print "ATTR YOK  : " path "\n"
            close(m)
            continue
        }

        Object o
        for o in entire m do {
            if (isDeleted(o)) continue

            string v = probeAttr_(o, ATTR)
            if (null v) continue

            if (v == TARGET) {
                int id = o."Absolute Number"
                print path "\tID " id "\n"
                found++
            }
        }

        close(m)
    }

    print "-------------------------------------------\n"
    print scanned " modul tarandi, " found " nesne bulundu.\n"
}

print "BITTI\n"
