//  FonksiyonIsterExport.dxl   (v2 - tani/debug surumu)
//
//  Secilen DOORS klasoru (or. LLR) altindaki TUM formal modulleri (alt klasorler dahil)
//  gezer; her modulde Kind=="Function" olan nesnelerin altindaki Kind=="Requirement"
//  nesnelerini CSV'ye yazar.
//
//  CSV kolonlari:
//    1) Sinif konumu : <Lib>/<Modul>/<Sinif basligi>   (or. Lib1/Module1/classx)
//    2) Fonksiyon    : Function nesnesinin basligi
//    3) Ister        : Requirement nesnesi (varsayilan: ID)
//
//  Kullanim: Database Explorer'da LLR klasorunu acin -> Tools > Edit DXL -> dosyayi
//            yukleyin -> Run.
//            DEBUG = true iken her adim Edit DXL penceresinin ALT kismina yazilir.
//            USE_DIALOG = false yaparsaniz pencere acilmaz, dogrudan calisir.

pragma runLim, 0

// =====================================================================================
//  1) AYARLAR
// =====================================================================================
bool   USE_DIALOG = true      // false: pencere acmadan dogrudan ROOT_PATH / CSV_PATH ile calisir
string ROOT_PATH  = ""        // bos: Database Explorer'da su an acik olan klasor. Or: "/Proje/LLR"
string CSV_PATH   = "C:\\Temp\\fonksiyon_isterler.csv"
bool   DEBUG      = true      // adim adim ciktiyi yazdir

string KIND_ATTR  = "Kind"
string KIND_CLASS = "Class"
string KIND_FUNC  = "Function"
string KIND_REQ   = "Requirement"

string CSV_SEP           = ";"     // Turkce Excel icin ";"
int    REQ_MODE          = 0       // 0 = ID, 1 = metin, 2 = "ID - metin"
bool   ONE_ROW_PER_REQ   = true    // false: bir fonksiyonun isterleri tek hucrede
string MULTI_REQ_SEP     = ", "
bool   WRITE_EMPTY_FUNCS = true    // isteri olmayan fonksiyonlari da yaz
bool   USE_HIERARCHY     = true    // true: ister Function'in child'i olmali | false: duz siralama
bool   ONLY_MAPPED       = false   // true: sadece sozlukte tanimli klasor/moduller islenir

// =====================================================================================
//  2) ISIM SOZLUGU  (DXL'de sozluk = Skip list)
//     put(<harita>, "<DOORS'taki ad>", "<CSV'de gorunecek ad>")
//     Anahtar: ad ("Module1") veya kok klasore gore yol ("Lib1/Module1")
// =====================================================================================
Skip libMap = createString()
Skip modMap = createString()

void tanimlaIsimler() {
    // ---------- Klasorler (Lib) ----------
    put(libMap, "Lib1", "Lib1_GercekAdi")
    put(libMap, "Lib2", "Lib2_GercekAdi")
    put(libMap, "Lib3", "Lib3_GercekAdi")

    // ---------- Moduller ----------
    put(modMap, "Module1", "Module1_GercekAdi")
    put(modMap, "Module2", "Module2_GercekAdi")
    put(modMap, "Module3", "Module3_GercekAdi")
    put(modMap, "Module4", "Module4_GercekAdi")
    put(modMap, "Module5", "Module5_GercekAdi")
    put(modMap, "Module6", "Module6_GercekAdi")

    // Ayni isimli modul farkli Lib'lerde varsa:
    // put(modMap, "Lib1/Module1", "Lib1_icin_Module1_Adi")
}

// =====================================================================================
//  3) YARDIMCILAR
// =====================================================================================
Skip modFull = create
Skip modDisp = create
int  modCount    = 0
int  reqSeq      = 0
int  totalRows   = 0
int  totalFuncs  = 0
int  totalReqs   = 0
int  orphanCount = 0
int  noKindCount = 0
int  errCount    = 0

void dbg(string s) {
    if (DEBUG) print(s "\n")
}

string mapName(Skip m, string relKey, string nm) {
    string v = ""
    if (find(m, relKey, v)) return v
    if (find(m, nm, v))     return v
    return nm
}

bool isMapped(Skip m, string relKey, string nm) {
    string v = ""
    if (find(m, relKey, v)) return true
    if (find(m, nm, v))     return true
    return false
}

string csvField(string s) {
    Buffer b = create
    int i
    char c
    b += "\""
    for (i = 0; i < length(s); i++) {
        c = s[i]
        if (c == '"')                    b += "\"\""
        else if (c == '\n' || c == '\r') b += " "
        else                             b += c
    }
    b += "\""
    string r = stringOf(b)
    delete b
    return r
}

void writeRow(Stream out, string c1, string c2, string c3) {
    string line = csvField(c1) CSV_SEP csvField(c2) CSV_SEP csvField(c3) "\n"
    out << line
    totalRows++
}

string objName(Object o) {
    string h = o."Object Heading" ""
    if (null h) h = o."Object Text" ""
    return h
}

string reqValue(Object o) {
    string id = identifier(o)
    if (REQ_MODE == 0) return id
    string t = o."Object Text" ""
    if (REQ_MODE == 1) return t
    return id " - " t
}

Object findAncestor(Object o, string kind) {
    Object p = parent(o)
    while (!null p) {
        string k = p.KIND_ATTR ""
        if (k == kind) return p
        p = parent(p)
    }
    return null
}

void collectModules(Folder f, string relPrefix, string dispPrefix) {
    Item itm
    for itm in f do {
        if (isDeleted(itm)) continue
        string t   = type(itm)
        string nm  = name(itm)
        string rel = nm
        if (!null relPrefix) rel = relPrefix "/" nm

        dbg("  bulundu: [" t "] " fullName(itm))

        if (t == "Folder" || t == "Project") {
            if (ONLY_MAPPED && !isMapped(libMap, rel, nm)) {
                dbg("    -> sozlukte yok, atlandi")
                continue
            }
            string dName = mapName(libMap, rel, nm)
            string dPath = dName
            if (!null dispPrefix) dPath = dispPrefix "/" dName
            collectModules(folder(fullName(itm)), rel, dPath)
        }
        else if (t == "Formal") {
            if (ONLY_MAPPED && !isMapped(modMap, rel, nm)) {
                dbg("    -> sozlukte yok, atlandi")
                continue
            }
            string mName = mapName(modMap, rel, nm)
            string mPath = mName
            if (!null dispPrefix) mPath = dispPrefix "/" mName
            put(modFull, modCount, fullName(itm))
            put(modDisp, modCount, mPath)
            modCount++
        }
    }
}

// =====================================================================================
//  4) TEK MODUL
// =====================================================================================
void processModule(string fn, string dispPath, Stream out) {
    dbg("")
    dbg("MODUL: " fn "   (CSV yolu: " dispPath ")")

    bool wasOpen = open(module fn)

    noError()
    Module m = read(fn, false)
    string err = lastError()
    if (!null err || null m) {
        errCount++
        dbg("  HATA: modul acilamadi: " err)
        return
    }

    AttrDef ad = find(m, KIND_ATTR)
    if (null ad) {
        noKindCount++
        dbg("  UYARI: '" KIND_ATTR "' niteligi yok, modul atlandi")
        if (!wasOpen) close(m)
        return
    }

    Skip funcObj  = create
    Skip funcIdx  = create
    Skip funcCls  = create
    Skip funcReqs = create
    Skip kindCnt  = createString()   // tani: Kind degerlerinin dagilimi
    int    nFunc    = 0
    int    nObj     = 0
    int    nOrphan  = 0
    string curClass = ""
    int    curFunc  = -1

    Object o
    for o in entire m do {
        if (isDeleted(o)) continue
        nObj++
        string k = o.KIND_ATTR ""

        // tani sayaci
        int kc = 0
        string kKey = k
        if (null kKey) kKey = "(bos)"
        if (find(kindCnt, kKey, kc)) delete(kindCnt, kKey)
        put(kindCnt, kKey, kc + 1)

        if (k == KIND_CLASS) {
            curClass = objName(o)
            curFunc  = -1
        }
        else if (k == KIND_FUNC) {
            string cls = curClass
            if (USE_HIERARCHY) {
                Object c = findAncestor(o, KIND_CLASS)
                if (null c) cls = ""
                else        cls = objName(c)
            }
            Skip rsNew = create
            put(funcObj,  nFunc, o)
            put(funcIdx,  o, nFunc)
            put(funcCls,  nFunc, cls)
            put(funcReqs, nFunc, rsNew)
            curFunc = nFunc
            nFunc++
        }
        else if (k == KIND_REQ) {
            int idx = -1
            if (USE_HIERARCHY) {
                Object fo = findAncestor(o, KIND_FUNC)
                if (!null fo) {
                    int tmp = -1
                    if (find(funcIdx, fo, tmp)) idx = tmp
                }
            } else {
                idx = curFunc
            }

            if (idx < 0) {
                orphanCount++
                nOrphan++
                continue
            }

            Skip rs = null
            if (find(funcReqs, idx, rs)) {
                put(rs, reqSeq, reqValue(o))
                reqSeq++
            }
        }
    }

    // tani ciktisi
    dbg("  nesne sayisi: " nObj ", Function: " nFunc ", fonksiyona baglanamayan ister: " nOrphan)
    Buffer kb = create
    int cntV
    for cntV in kindCnt do {
        string kName = (string key kindCnt)
        kb += "'" kName "'=" cntV "  "
    }
    dbg("  Kind dagilimi: " stringOf(kb))
    delete kb
    delete kindCnt

    // CSV'ye yaz
    int i
    for (i = 0; i < nFunc; i++) {
        Object fObj = null
        string cls  = ""
        Skip   rs   = null
        find(funcObj,  i, fObj)
        find(funcCls,  i, cls)
        find(funcReqs, i, rs)

        string loc = dispPath
        if (!null cls) loc = dispPath "/" cls
        string fname = objName(fObj)
        totalFuncs++

        Buffer joined = create
        int cnt = 0
        string v
        for v in rs do {
            if (ONE_ROW_PER_REQ) {
                writeRow(out, loc, fname, v)
            } else {
                if (cnt > 0) joined += MULTI_REQ_SEP
                joined += v
            }
            cnt++
            totalReqs++
        }
        if (!ONE_ROW_PER_REQ && cnt > 0) writeRow(out, loc, fname, stringOf(joined))
        if (cnt == 0 && WRITE_EMPTY_FUNCS) writeRow(out, loc, fname, "")

        delete joined
        delete rs
    }

    delete funcObj
    delete funcIdx
    delete funcCls
    delete funcReqs

    if (!wasOpen) close(m)
}

// =====================================================================================
//  5) ANA ISLEM
// =====================================================================================
DB  dlg       = null
DBE dbeFolder = null
DBE dbeFile   = null

void runExport(string rootPath, string csvPath) {
    dbg("=== Disa aktarim basladi ===")
    dbg("Kok klasor : '" rootPath "'")
    dbg("CSV dosyasi: '" csvPath "'")

    if (null rootPath) { warningBox("Kok klasor bos. Lutfen klasor yolunu girin."); return }
    if (null csvPath)  { warningBox("CSV dosya yolu bos."); return }

    noError()
    Item rootItem = item(rootPath)
    string e = lastError()
    if (!null e || null rootItem) {
        warningBox("Klasor bulunamadi:\n" rootPath "\n\n" e)
        return
    }
    string rt = type(rootItem)
    dbg("Kok ogenin tipi: " rt)
    if (rt != "Folder" && rt != "Project") {
        warningBox("Secilen oge klasor/proje degil (tip: " rt "):\n" rootPath)
        return
    }

    delete modFull
    modFull = create
    delete modDisp
    modDisp = create
    modCount = 0
    reqSeq = 0
    totalRows = 0
    totalFuncs = 0
    totalReqs = 0
    orphanCount = 0
    noKindCount = 0
    errCount = 0

    dbg("Klasor taraniyor...")
    collectModules(folder(rootPath), "", "")
    dbg("Bulunan formal modul sayisi: " modCount)

    if (modCount == 0) {
        warningBox("Secilen klasor altinda formal modul bulunamadi:\n" rootPath)
        return
    }

    noError()
    Stream out = write(csvPath)
    // UTF-8 icin:  Stream out = write(csvPath, CP_UTF8)
    e = lastError()
    if (!null e) {
        warningBox("CSV dosyasi acilamadi (klasor var mi? dosya Excel'de acik mi?):\n" csvPath "\n\n" e)
        return
    }

    writeRow(out, "Sinif Konumu", "Fonksiyon", "Ister")
    totalRows = 0

    bool useProg = !null dlg
    if (useProg) progressStart(dlg, "Fonksiyon / Ister Disa Aktarimi", "", modCount)

    int i
    for (i = 0; i < modCount; i++) {
        string fn = ""
        string dp = ""
        find(modFull, i, fn)
        find(modDisp, i, dp)
        if (useProg) progressMessage(dp)
        processModule(fn, dp, out)
        if (useProg) {
            progressStep(i + 1)
            if (progressCancelled()) {
                dbg("Kullanici iptal etti.")
                break
            }
        }
    }
    if (useProg) progressStop()
    close(out)

    Buffer sb = create
    sb += "Tamamlandi.\n\n"
    sb += "Islenen modul : " modCount "\n"
    sb += "Fonksiyon     : " totalFuncs "\n"
    sb += "Ister         : " totalReqs "\n"
    sb += "CSV satiri    : " totalRows "\n"
    sb += "Fonksiyona baglanamayan ister : " orphanCount "\n"
    sb += "Kind niteligi olmayan modul   : " noKindCount "\n"
    sb += "Acilamayan modul              : " errCount "\n\n"
    sb += "Dosya: " csvPath
    string summary = stringOf(sb)
    delete sb

    dbg("")
    dbg(summary)
    infoBox(summary)
}

void runCB(DB d) {
    string r = get(dbeFolder)
    string c = get(dbeFile)
    runExport(r, c)
}

// =====================================================================================
//  6) BASLAT
// =====================================================================================
dbg("=== Script basladi ===")
tanimlaIsimler()

string startPath = ROOT_PATH
if (null startPath) {
    Folder cf = current
    if (!null cf) startPath = fullName(cf)
}
dbg("Baslangic klasoru: '" startPath "'")

if (USE_DIALOG) {
    dlg = create("Fonksiyon / Ister CSV Disa Aktarimi")
    label(dlg, "Kok klasor altindaki tum formal moduller (alt klasorler dahil) islenecek.")
    dbeFolder = field(dlg, "Kok klasor:", startPath, 60)
    dbeFile   = field(dlg, "CSV dosyasi:", CSV_PATH, 60)
    apply(dlg, "Calistir", runCB)
    dbg("Pencere aciliyor - 'Calistir' dugmesine basin.")
    show dlg
} else {
    runExport(startPath, CSV_PATH)
}
