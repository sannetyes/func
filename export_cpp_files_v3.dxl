/*
    export_cpp_files.dxl   -- DOORS 9.7 uyumlu

    Hiyerarsik bir DOORS modulunden SADECE kaynak dosya nesnelerini cikarir.
    Klasor / baslik nesneleri atlanir. Filtreleme seviyeye gore degil, isim
    uzantisina gore yapilir; dosyalar hangi derinlikte olursa olsun yakalanir.

    Yol bilgisi parent() ile yukari yurunerek DEGIL, level() tabanli bir
    yigin ile kuruluyor -- boylece sonsuz dongu (pragma runLim) riski yok.

    KULLANIM
      1. Modulu ac.
      2. Tools > Edit DXL...
      3. Yapistir, AYARLAR bolumunu duzenle, Run.
*/

// ---------------------------------------------------------------------------
// AYARLAR
// ---------------------------------------------------------------------------
string NAME_ATTR = "Object Heading"   // dosya adinin durdugu attribute
string FLAG_ATTR = "IsDesign"         // 2. kolon
string OUT_FILE  = "C:/temp/cpp_files.csv"
string DELIM     = ";"

bool INCLUDE_PATH = true    // ust klasorlerden olusan yolu da yaz
bool INCLUDE_ID   = false   // Absolute Number kolonu ekle
bool ONLY_VISIBLE = false   // true -> sadece filtreden gecen nesneler

const int MAX_DEPTH = 64    // desteklenen en fazla hiyerarsi derinligi

// string anahtar icin 'createString' sart; duz 'create' adrese gore
// karsilastirir ve find() hicbir zaman eslesmez.
Skip EXTS = createString
put(EXTS, "cpp", "")
put(EXTS, "c",   "")
put(EXTS, "cxx", "")
put(EXTS, "cc",  "")
put(EXTS, "h",   "")
put(EXTS, "hpp", "")

string pathStack[MAX_DEPTH]

int rowCount  = 0
int skipCount = 0

// ---------------------------------------------------------------------------
// KUCUK YARDIMCILAR
// ---------------------------------------------------------------------------
string trim(string s) {
    if (null s) return ""
    int len = length(s)
    if (len == 0) return ""

    int a = 0
    int b = len - 1
    while (a <= b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\n' || s[a] == '\r')) a++
    while (b >= a && (s[b] == ' ' || s[b] == '\t' || s[b] == '\n' || s[b] == '\r')) b--
    if (a > b) return ""
    return s[a:b]
}

string fileExt(string s) {
    int dot = -1
    int i
    for (i = 0; i < length(s); i++) {
        char c = s[i]
        if (c == '.')                    dot = i
        else if (c == '/' || c == '\\')  dot = -1
    }
    if (dot < 0 || dot == length(s) - 1) return ""
    return lower(s[dot + 1 : length(s) - 1])
}

bool isSourceFile(string name) {
    string ext = fileExt(trim(name))
    if (ext == "") return false
    return find(EXTS, ext)
}

// Attribute degerini TIPTEN BAGIMSIZ oku (bool / enum / int de olabilir)
string attrText(Object o, string attrName) {
    string v = probeAttr_(o, attrName)
    if (null v) return ""
    return v
}

string csvEscape(string s) {
    if (null s) return "\"\""
    Buffer b = create
    b += "\""
    int i
    for (i = 0; i < length(s); i++) {
        char c = s[i]
        if (c == '"')                                  b += "\"\""
        else if (c == '\n' || c == '\r' || c == '\t')  b += " "
        else                                           b += c
    }
    b += "\""
    string r = stringOf(b)
    delete b
    return r
}

// lv seviyesindeki nesnenin ustundeki klasorlerden yol kurar
string buildPath(int lv) {
    string path = ""
    int k
    for (k = 0; k < lv - 1 && k < MAX_DEPTH; k++) {
        if (pathStack[k] != "") path = path pathStack[k] "/"
    }
    // sondaki '/' karakterini at
    int n = length(path)
    if (n > 0) return path[0 : n - 2]
    return ""
}

// ---------------------------------------------------------------------------
void writeRow(Stream out, Object o) {
    if (isDeleted(o)) return

    string name = trim(attrText(o, NAME_ATTR))
    int lv = level(o)

    // Once yigini guncelle: klasor satirlari yolu tasiyor, atlanmadan once
    // kaydedilmeleri gerekiyor.
    if (lv >= 1 && lv <= MAX_DEPTH) {
        pathStack[lv - 1] = name
        // daha derin eski girisleri temizle
        int k
        for (k = lv; k < MAX_DEPTH; k++) pathStack[k] = ""
    }

    if (!isSourceFile(name)) {
        skipCount++
        return
    }

    if (INCLUDE_ID)   out << csvEscape(attrText(o, "Absolute Number")) << DELIM
    if (INCLUDE_PATH) out << csvEscape(buildPath(lv))                  << DELIM

    out << csvEscape(name) << DELIM
    out << csvEscape(attrText(o, FLAG_ATTR)) << "\n"

    rowCount++
}

void run() {
    Module m = current Module
    if (null m) { ack "Once bir modul acmalisin."; return }

    AttrDef adName = find(m, NAME_ATTR)
    if (null adName) {
        ack "Bu modulde '" NAME_ATTR "' adinda bir attribute yok."
        return
    }
    AttrDef adFlag = find(m, FLAG_ATTR)
    if (null adFlag) {
        ack "Bu modulde '" FLAG_ATTR "' adinda bir attribute yok."
        return
    }

    int i
    for (i = 0; i < MAX_DEPTH; i++) pathStack[i] = ""

    Stream out = write(OUT_FILE)
    if (null out) {
        ack "Dosya yazilamadi: " OUT_FILE "\nKlasor var mi, yazma izni var mi?"
        return
    }

    if (INCLUDE_ID)   out << csvEscape("Absolute Number") << DELIM
    if (INCLUDE_PATH) out << csvEscape("Path")            << DELIM
    out << csvEscape("File") << DELIM << csvEscape(FLAG_ATTR) << "\n"

    Object o
    if (ONLY_VISIBLE) { for o in m        do { writeRow(out, o) } }
    else              { for o in entire m do { writeRow(out, o) } }

    close(out)
    delete EXTS

    infoBox "Bitti.\n" rowCount " kaynak dosya yazildi.\n" skipCount " klasor/baslik atlandi.\n\n" OUT_FILE
}

run()
