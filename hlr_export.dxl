// ============================================================================
//  hlr_export.dxl
//
//  DOORS formal modulundeki
//      Paket / Sinif / Operations / fonksiyon / requirement
//  hiyerarsisinden 3 sutunlu bir CSV uretir (Excel dogrudan acar).
//
//  Modul yapisi:                       Uretilen CSV (fonksiyon basina 1 satir):
//
//    database                            "Directory Name";"Function Name";"HLR Ids"
//      class1                            "database/class1";"func1";"REQ_1, REQ_2, REQ_3"
//        Attributes     <- atlanir       "database/class1";"func2";"REQ_4, REQ_5, REQ_6"
//        Operations
//          func1
//            req1
//            req2
//            req3
//          func2
//            req4
//            req5
//            req6
//      class2
//    devices
//      class3
//      ...
//
//  * Function Name  = 'Operations' basliginin DOGRUDAN alt nesnesinin basligi
//                     (Object Heading).  Fonksiyon nesnesinin kendi ID'si
//                     YAZILMAZ.
//  * HLR Ids        = o fonksiyonun altindaki requirement nesnelerinin ID'leri,
//                     DOORS'taki sirayla, ID_JOIN ile birlestirilmis.
//  * Directory Name = 'Operations' basligina kadar olan ust basliklar, '/' ile
//                     birlestirilmis (ic ice paketler de dahil: pkg/sub/class1).
//  * 'Attributes' altindakiler ve 'Operations' disindaki her sey atlanir.
//
//  Kullanim:
//    1) Modulu ac.
//    2) Tools > Edit DXL...  -> bu dosyayi yukle (Load) -> AYARLAR'i kontrol et
//    3) Run.  Bitince ozet penceresi cikar.
//
//  Filtre / gorunum fark etmez: tum (silinmemis) nesneler taranir.
// ============================================================================


// ================================ AYARLAR ===================================

string OUTPUT_FILE     = "C:\\Temp\\hlr_export.csv"  // klasor var olmali
string MODULE_PATH     = ""             // bos = acik modul;  ya da "/Proje/Klasor/Modul"
string ID_COLUMN       = "ID"           // requirement ID'sinin okunacagi sutunun
                                        // basligi.  Gorunumde boyle bir sutun
                                        // yoksa ve deger "ID" ise nesnenin kendi
                                        // DOORS ID'si kullanilir.
string OPERATIONS_NAME = "Operations"   // fonksiyonlarin altinda durdugu baslik
string DELIM           = ";"            // Turkce Excel icin ";"  ( "," de olur )
string ID_JOIN         = ", "           // ayni hucredeki ID'ler arasina
bool   INCLUDE_NESTED  = true           // true : fonksiyonun altindaki TUM seviyeler
                                        //        (req'in altindaki alt req'ler dahil)
                                        // false: sadece fonksiyonun dogrudan altlari
bool   WRITE_EMPTY_IDS = true           // altinda requirement olmayan fonksiyonlar
                                        // da (bos ID ile) yazilsin mi
int    SKIP_TOP_LEVELS = 0              // Directory Name'den atilacak ust seviye
                                        // sayisi (en ustte 'Model' gibi bir kok
                                        // baslik varsa 1 yap)

// ============================================================================


// ------------------------------------------------------------ durum degiskenleri

Column idCol     = null     // ID'lerin okunacagi gorunum sutunu (yoksa identifier)
Stream outFile

bool   inFunc    = false    // su an bir fonksiyonun altini mi okuyoruz
int    funcLevel = 0        // o fonksiyonun seviyesi
string curName   = ""
string curDir    = ""
Buffer idBuf     = create
int    curCount  = 0

int nOps     = 0            // bulunan 'Operations' basligi (= sinif)
int nFunc    = 0            // yazilan fonksiyon satiri
int nReq     = 0            // ID'si alinan requirement
int nNoReq   = 0            // altinda ID'li requirement olmayan fonksiyon
int nSkipped = 0            // bu yuzden yazilmayan


// ---------------------------------------------------------------- yardimcilar

bool isWs(char ch) {
    return (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r')
}

// Satir sonu / tab -> tek bosluk; bastaki ve sondaki bosluklar atilir
string cleanText(string s) {
    Buffer b = create
    int i
    int n = length(s)
    bool lastWs = true
    char ch
    string r
    for (i = 0; i < n; i++) {
        ch = s[i]
        if (isWs(ch)) {
            if (!lastWs) {
                b += ' '
            }
            lastWs = true
        } else {
            b += ch
            lastWs = false
        }
    }
    r = stringOf(b)
    delete b
    if (length(r) > 0 && r[length(r) - 1] == ' ') {
        r = r[0:length(r) - 2]
    }
    return r
}

// Sadece A-Z -> a-z  (karsilastirma icin)
string lowerAscii(string s) {
    Buffer b = create
    int i
    int n = length(s)
    int code
    string r
    for (i = 0; i < n; i++) {
        code = intOf(s[i])
        if (code >= 65 && code <= 90) {
            code = code + 32
        }
        b += charOf(code)
    }
    r = stringOf(b)
    delete b
    return r
}

bool sameName(string a, string b) {
    return lowerAscii(cleanText(a)) == lowerAscii(cleanText(b))
}

string firstLine(string s) {
    int i
    int n = length(s)
    for (i = 0; i < n; i++) {
        if (s[i] == '\n' || s[i] == '\r') {
            if (i == 0) {
                return ""
            }
            return s[0:i - 1]
        }
    }
    return s
}

// Nesnenin agactaki adi: Object Heading, bossa Object Text'in ilk satiri
string nodeName(Object o) {
    string h = o."Object Heading" ""
    string t
    h = cleanText(h)
    if (h != "") {
        return h
    }
    t = o."Object Text" ""
    return cleanText(firstLine(t))
}

bool isOperationsNode(Object o) {
    if (null o) {
        return false
    }
    return sameName(nodeName(o), OPERATIONS_NAME)
}

// 'Operations' nesnesinin ust basliklari:  database/class1
string classPath(Object ops) {
    string path = ""
    string nm
    Object p = parent(ops)
    while (!null p) {
        if (level(p) > SKIP_TOP_LEVELS) {
            nm = nodeName(p)
            if (nm != "") {
                if (path == "") {
                    path = nm
                } else {
                    path = nm "/" path
                }
            }
        }
        p = parent(p)
    }
    return path
}

// Hucredeki ID'leri ayir (satir sonu , ; | tab) ve ID_JOIN ile birlestir
string normalizeIds(string s) {
    Buffer outB = create
    Buffer tok = create
    int i
    int n = length(s)
    int count = 0
    bool isSep
    char ch
    string t
    string r
    for (i = 0; i <= n; i++) {
        isSep = (i == n)
        if (!isSep) {
            ch = s[i]
            isSep = (ch == '\n' || ch == '\r' || ch == ',' || ch == ';' || ch == '|' || ch == '\t')
        }
        if (isSep) {
            t = cleanText(stringOf(tok))
            if (t != "") {
                if (count > 0) {
                    outB += ID_JOIN
                }
                outB += t
                count++
            }
            setempty(tok)
        } else {
            tok += ch
        }
    }
    r = stringOf(outB)
    delete outB
    delete tok
    return r
}

string rawIds(Object o) {
    if (!null idCol) {
        return text(idCol, o)
    }
    return identifier(o)
}

// CSV alani:
//  * degerdeki tirnak (") karakterleri silinir (isimlerde/ID'lerde olmaz;
//    DOORS basliginda varsa ciktida """" gibi gorunmesin diye)
//  * alan SADECE ayrac ya da satir sonu iceriyorsa tirnak icine alinir.
//    DELIM = ";" iken hicbir alan tirnaklanmaz:  database/class1;func1;REQ_1, REQ_2
string csvField(string s) {
    Buffer b = create
    int i
    int n = length(s)
    bool needQuote = false
    char ch
    char sep = DELIM[0]
    string r
    for (i = 0; i < n; i++) {
        ch = s[i]
        if (ch != '"') {
            if (ch == sep || ch == '\n' || ch == '\r') {
                needQuote = true
            }
            b += ch
        }
    }
    r = stringOf(b)
    if (needQuote) {
        setempty(b)
        b += '"'
        b += r
        b += '"'
        r = stringOf(b)
    }
    delete b
    return r
}


// ------------------------------------------------------ fonksiyon toplama

void startFunc(Object f, Object ops) {
    inFunc    = true
    funcLevel = level(f)
    curName   = nodeName(f)
    curDir    = classPath(ops)
    curCount  = 0
    setempty(idBuf)
}

void addReq(Object r) {
    string ids = normalizeIds(rawIds(r))
    if (ids == "") {
        return
    }
    if (curCount > 0) {
        idBuf += ID_JOIN
    }
    idBuf += ids
    curCount++
    nReq++
}

void flushFunc() {
    string ids = stringOf(idBuf)
    inFunc = false
    if (curName == "") {
        return
    }
    if (curCount == 0) {
        nNoReq++
        if (!WRITE_EMPTY_IDS) {
            nSkipped++
            return
        }
    }
    outFile << csvField(curDir) DELIM csvField(curName) DELIM csvField(ids) "\n"
    nFunc++
}


// ------------------------------------------------------------------- modul

Module m = current
if (MODULE_PATH != "") {
    m = read(MODULE_PATH, false)
}

string errMsg = ""

if (null m) {
    errMsg = "Modul bulunamadi.\n\n"
    errMsg = errMsg "Script'i acik bir formal modulun Tools > Edit DXL penceresinden "
    errMsg = errMsg "calistirin ya da MODULE_PATH'i doldurun."
    errorBox(errMsg)
    halt
}


// -------------------------------------------------------------- ID sutunu

Column col
for col in m do {
    if (sameName(title(col), ID_COLUMN)) {
        idCol = col
        break
    }
}

string idSourceInfo = ""
if (!null idCol) {
    idSourceInfo = "gorunumdeki '" ID_COLUMN "' sutunu"
} else if (sameName(ID_COLUMN, "ID")) {
    idSourceInfo = "nesnelerin DOORS ID'si"
} else {
    errMsg = "Gorunumde '" ID_COLUMN "' baslikli sutun yok.\n\n"
    errMsg = errMsg "Bu sutunun gorundugu gorunumu acin ya da ID_COLUMN ayarini "
    errMsg = errMsg "sutun basligiyla ayni yapin."
    errorBox(errMsg)
    halt
}


// ------------------------------------------------------------- dosya

noError()
outFile = write(OUTPUT_FILE)
string writeErr = lastError()
if (!null writeErr) {
    errMsg = "Cikti dosyasi acilamadi:\n" OUTPUT_FILE "\n\n" writeErr "\n\n"
    errMsg = errMsg "Klasorun var oldugundan emin olun ya da OUTPUT_FILE'i degistirin."
    errorBox(errMsg)
    halt
}

string header = csvField("Directory Name") DELIM csvField("Function Name") DELIM csvField("HLR Ids")
outFile << header "\n"


// ------------------------------------------------------------- tarama
//
// 'for o in entire m' nesneleri dokuman sirasiyla (derinlik oncelikli) verir:
// bir fonksiyonun hemen ardindan, seviyesi ondan buyuk olan nesneler onun
// altindaki requirement'lardir.  Seviye fonksiyonunkine dusunce o fonksiyon
// biter ve satiri yazilir.

Object o
Object par
int lv

for o in entire m do {
    if (isDeleted(o)) {
        continue
    }
    lv = level(o)

    if (inFunc) {
        if (lv > funcLevel) {
            if (INCLUDE_NESTED || lv == funcLevel + 1) {
                addReq(o)
            }
            continue
        }
        flushFunc()
    }

    if (isOperationsNode(o)) {
        nOps++
        continue
    }

    par = parent(o)
    if (null par) {
        continue
    }
    if (isOperationsNode(par)) {
        startFunc(o, par)
    }
}

if (inFunc) {
    flushFunc()
}

close(outFile)
delete idBuf


// -------------------------------------------------------------- ozet

string msg = "Bitti.\n\n"
msg = msg "Dosya:  " OUTPUT_FILE "\n"
msg = msg "ID kaynagi:  " idSourceInfo "\n\n"
msg = msg "'" OPERATIONS_NAME "' basligi (sinif):  " nOps "\n"
msg = msg "Yazilan fonksiyon:  " nFunc "\n"
msg = msg "Alinan requirement ID'si:  " nReq "\n"
msg = msg "Altinda requirement olmayan fonksiyon:  " nNoReq ""

if (nSkipped > 0) {
    msg = msg " (" nSkipped " tanesi yazilmadi)"
}

if (nOps == 0) {
    msg = msg "\n\nUYARI: Hic '" OPERATIONS_NAME "' basligi bulunamadi.\n"
    msg = msg "OPERATIONS_NAME ayarini moduldeki baslikla ayni yapin."
    warningBox(msg)
} else {
    infoBox(msg)
}
